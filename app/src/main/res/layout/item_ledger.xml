<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTxRef"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ref: RCPT-8471203"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"/>

            <TextView
                android:id="@+id/tvTxAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ KES 12,500.00"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#10B981"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvTxCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Category: POS Sale (Cash)"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"/>

            <TextView
                android:id="@+id/tvTxDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-08-04"
                android:textSize="12sp"
                android:textColor="#888888"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvTxPayerPayee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Party: POS Customer (by admin)"
            android:textSize="11sp"
            android:textColor="#666666"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
