<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HardwareMobileERP" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#3498db</item>
        <item name="colorSecondary">#2ecc71</item>

        <!-- Theme-aware high-contrast text and input colors for Dark Mode -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:editTextColor">@color/input_text</item>
        <item name="editTextColor">@color/input_text</item>
        <item name="android:textColorHint">@color/input_hint</item>

        <item name="colorSurface">@color/card_bg</item>
        <item name="android:colorBackground">@color/app_bg</item>

        <item name="android:statusBarColor">#1A252F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>
</resources>